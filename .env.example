# PostgreSQL Database Configuration
POSTGRES_USER=peito_user
POSTGRES_PASSWORD=peito_secret_lan
POSTGRES_DB=peito_infinity
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://peito_user:peito_secret_lan@db:5432/peito_infinity

# Seed Configuration (Usado apenas na 1ª execução se o banco estiver vazio)
SEED_FILE_PATH=/app/specs/data/guia-exercicios-seed.md

# LLM Specialist Agent Configuration
# Opções de LLM_PROVIDER: lm_studio | ollama | openai | gemini | specialist_engine
LLM_PROVIDER=lm_studio
LLM_MODEL=google/gemma-4-12b-qat
LLM_API_KEY=local
OLLAMA_BASE_URL=http://localhost:1234

# Ports on LAN Host
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api/v1
